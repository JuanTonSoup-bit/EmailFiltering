# Copy to .env and adjust as needed.

# Path to the OAuth client secret downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_FILE=credentials.json
# Where the OAuth access/refresh token is cached after first login.
GMAIL_TOKEN_FILE=token.json

# SQLite database location.
DATABASE_URL=sqlite:///./data/phishguard.db

# How often the poller checks for new mail, in seconds.
POLL_INTERVAL_SECONDS=120
# Max messages to pull per poll cycle.
POLL_MAX_RESULTS=25
# Only scan mail newer than this many days on first run.
INITIAL_LOOKBACK_DAYS=3

# Score thresholds (0-100). >= SUSPICIOUS => phishing label; >= JUNK => junk label.
SUSPICIOUS_THRESHOLD=50
JUNK_THRESHOLD=25

# Gmail label names applied to flagged mail.
LABEL_SUSPICIOUS=PhishGuard/Suspicious
LABEL_JUNK=PhishGuard/Junk
